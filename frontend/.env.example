# ─── AtmoLens Environment Variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in the values for local development.
# For Vercel deployment, configure these in the Vercel Dashboard → Settings → Environment Variables.

# ─── Required ────────────────────────────────────────────────────────────────

# Neon Postgres connection string (pooled recommended for serverless)
POSTGRES_URL=postgres://user:password@host/database?sslmode=require

# Vercel Blob storage read/write token (auto-configured when you add Blob storage to your Vercel project)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# ─── Optional ────────────────────────────────────────────────────────────────

# Secret for authenticating cron/maintenance API routes. If unset, those routes are open.
# Also configure this as a GitHub Actions secret for the fetch-maps scheduler.
# CRON_SECRET=your-secret-here

# Blob access mode: "public" or "private" (default: "private")
# BLOB_ACCESS=private

# Archive retention for age-based cleanup (default: 14 days)
# ARCHIVE_RETENTION_DAYS=14

# Max width of processed synoptic maps in pixels (default: 1200)
# MAX_MAP_WIDTH=1200

# Custom blob quota in bytes for diagnostics reporting (default: 1000000000 = 1GB)
# BLOB_QUOTA_BYTES=1000000000

# Max blobs to scan during diagnostics health check (default: 3000)
# DIAGNOSTIC_BLOB_SCAN_LIMIT=3000
